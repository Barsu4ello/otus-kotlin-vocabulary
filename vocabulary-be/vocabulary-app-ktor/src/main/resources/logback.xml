<?xml version="1.0" encoding="UTF-8"?>
<configuration>

    <property name="LOG_COMMON_LEVEL" value="${LOG_COMMON_LEVEL:-INFO}"/>

    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} [%thread] %-5level[%marker] %logger{36} - %msg%n%mdc%n</pattern>
        </encoder>
    </appender>

    <logger name="Application" level="INFO" additivity="false">
        <appender-ref ref="STDOUT"/>
    </logger>

    <logger name="io.netty" level="WARN"/>
    <logger name="com.datastax.oss.driver" level="WARN"/>

    <root level="${LOG_COMMON_LEVEL}">
        <appender-ref ref="STDOUT"/>
    </root>

</configuration>